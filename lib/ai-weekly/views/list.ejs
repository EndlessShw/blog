<%
page.subtitle = page.title
page.banner_img = theme.page.banner_img
page.banner_img_height = theme.page.banner_img_height
page.banner_mask_alpha = theme.page.banner_mask_alpha
%>
<section class="py-3" aria-label="AI 周报列表">
  <h1 class="h4">AI 周报</h1>
  <p class="text-muted">由 AI 生成的每周报告，共 <%= page.report_total %> 期。</p>
  <% if (page.report_total === 0) { %>
    <p class="text-center py-5">暂无周报，首期发布后将在这里展示。</p>
  <% } else { %>
    <% page.posts.forEach(function (report) { %>
      <article class="py-3 border-bottom">
        <h2 class="h5"><a href="<%= url_for(report.path) %>"><%= report.title %></a></h2>
        <p class="text-muted mb-2"><time datetime="<%= report.published_at %>"><%= date(report.date, 'YYYY-MM-DD') %></time> · AI 生成</p>
        <% if (report.summary) { %><p class="mb-0"><%= report.summary %></p><% } %>
      </article>
    <% }) %>
    <%- partial('_partials/paginator') %>
  <% } %>
</section>
